<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- ombre portée au sol, pour l'ancrage 3D -->
    <path android:pathData="M50,90 m-22,0 a22,6 0 1 0 44,0 a22,6 0 1 0 -44,0" android:fillColor="@color/kawaii_shadow_soft" />

    <!-- mèches longues (dégradé lumière -> ombre) -->
    <path android:pathData="M14,55 C8,68 6,85 12,98 C18,90 20,72 20,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="10" android:startY="55" android:endX="16" android:endY="98"
                android:startColor="@color/kawaii_hair_light" android:endColor="@color/kawaii_hair_shadow" />
        </aapt:attr>
    </path>
    <path android:pathData="M86,55 C92,68 94,85 88,98 C82,90 80,72 80,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="90" android:startY="55" android:endX="84" android:endY="98"
                android:startColor="@color/kawaii_hair" android:endColor="@color/kawaii_hair_shadow" />
        </aapt:attr>
    </path>

    <!-- chevelure : volume en dégradé radial (lumière en haut à gauche) -->
    <path android:pathData="M50,16 A37,37 0 1 0 50.01,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="34" android:centerY="24" android:gradientRadius="48"
                android:startColor="@color/kawaii_hair_highlight" android:centerColor="@color/kawaii_hair" android:endColor="@color/kawaii_hair_shadow" />
        </aapt:attr>
    </path>
    <!-- reflet brillant sur les cheveux -->
    <path android:pathData="M30,18 C36,12 46,10 54,12 C46,14 39,19 35,27 C33,22 31,19 30,18 Z"
        android:fillColor="@color/kawaii_hair_highlight" android:fillAlpha="0.55" />

    <!-- peau : dégradé radial pour donner du volume au visage -->
    <path android:pathData="M50,33 A27,27 0 1 0 50.01,33 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="44" android:centerY="48" android:gradientRadius="34"
                android:startColor="@color/kawaii_skin_highlight" android:centerColor="@color/kawaii_skin" android:endColor="@color/kawaii_skin_shadow" />
        </aapt:attr>
    </path>

    <!-- sourcils -->
    <path android:pathData="M25,36 Q32,32 39,35" android:strokeColor="@color/kawaii_hair"
        android:strokeWidth="2" android:strokeLineCap="round" android:fillColor="#00000000" />
    <path android:pathData="M61,35 Q68,32 75,36" android:strokeColor="@color/kawaii_hair"
        android:strokeWidth="2" android:strokeLineCap="round" android:fillColor="#00000000" />

    <!-- yeux : iris façon verre avec dégradé + reflets -->
    <path android:pathData="M28,45 a9,10 0 1 0 18,0 a9,10 0 1 0 -18,0"
        android:fillColor="#FFFFFF" android:strokeColor="@color/kawaii_eye_outline" android:strokeWidth="1.4" />
    <path android:pathData="M62,45 a9,10 0 1 0 18,0 a9,10 0 1 0 -18,0"
        android:fillColor="#FFFFFF" android:strokeColor="@color/kawaii_eye_outline" android:strokeWidth="1.4" />

    <path android:pathData="M37,45 m-6.5,0 a6.5,6.5 0 1 0 13,0 a6.5,6.5 0 1 0 -13,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="34.5" android:centerY="42" android:gradientRadius="9"
                android:startColor="@color/kawaii_iris_light" android:centerColor="@color/kawaii_iris" android:endColor="@color/kawaii_iris_dark" />
        </aapt:attr>
    </path>
    <path android:pathData="M71,45 m-6.5,0 a6.5,6.5 0 1 0 13,0 a6.5,6.5 0 1 0 -13,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="68.5" android:centerY="42" android:gradientRadius="9"
                android:startColor="@color/kawaii_iris_light" android:centerColor="@color/kawaii_iris" android:endColor="@color/kawaii_iris_dark" />
        </aapt:attr>
    </path>
    <path android:pathData="M39,48 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0" android:fillColor="@color/kawaii_eye_outline" android:fillAlpha="0.65" />
    <path android:pathData="M73,48 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0" android:fillColor="@color/kawaii_eye_outline" android:fillAlpha="0.65" />
    <path android:pathData="M34,37 L35,40 L38,41 L35,42 L34,45 L33,42 L30,41 L33,40 Z" android:fillColor="#FFFFFF" />
    <path android:pathData="M68,37 L69,40 L72,41 L69,42 L68,45 L67,42 L64,41 L67,40 Z" android:fillColor="#FFFFFF" />
    <path android:pathData="M40,50 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#FFFFFF" android:fillAlpha="0.85" />
    <path android:pathData="M74,50 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#FFFFFF" android:fillAlpha="0.85" />

    <!-- joues : blush doux en dégradé -->
    <path android:pathData="M30,68 m-7,-5 a7,5 0 1 0 14,0 a7,5 0 1 0 -14,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="30" android:centerY="68" android:gradientRadius="8"
                android:startColor="@color/kawaii_cheek" android:endColor="@color/kawaii_cheek_soft" />
        </aapt:attr>
    </path>
    <path android:pathData="M70,68 m-7,-5 a7,5 0 1 0 14,0 a7,5 0 1 0 -14,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="70" android:centerY="68" android:gradientRadius="8"
                android:startColor="@color/kawaii_cheek" android:endColor="@color/kawaii_cheek_soft" />
        </aapt:attr>
    </path>

    <!-- bouche : petit sourire -->
    <path android:pathData="M43,78 Q50,82 57,78" android:strokeColor="@color/kawaii_mouth"
        android:strokeWidth="2.2" android:strokeLineCap="round" android:fillColor="#00000000" />
</vector>
